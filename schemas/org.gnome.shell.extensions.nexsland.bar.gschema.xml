<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="nexsland">
  <!-- Open Bar's settings (neuromorph/openbar) for styling the top bar and its buttons, as a child schema of Nexsland. -->
  <schema id="org.gnome.shell.extensions.nexsland.bar" path="/org/gnome/shell/extensions/nexsland/bar/">
    <key type="s" name="bartype">
      <default>"Floating"</default>
      <summary>Type of Top Bar</summary>
      <description>Type of Top Bar.</description>
    </key>
    <key type="as" name="fgcolor">
      <default>['1.0', '1.0', '1.0']</default>
      <summary>FG Color (RGBA)</summary>
      <description>FG Color of Top Bar.</description>
    </key>
    <key type="as" name="dark-fgcolor">
      <default>['1.0', '1.0', '1.0']</default>
      <summary>FG Color (RGBA)</summary>
      <description>FG Color of Top Bar.</description>
    </key>
    <key type="as" name="light-fgcolor">
      <default>['1.0', '1.0', '1.0']</default>
      <summary>FG Color (RGBA)</summary>
      <description>FG Color of Top Bar.</description>
    </key>
    <key type="d" name="fgalpha">
      <default>1.0</default>
      <summary>Transparency (alpha) foreground</summary>
      <description>Transparency of foreground.</description>
    </key>
    <key type="as" name="bgcolor">
      <default>['0.125', '0.125', '0.125']</default>
      <summary>BG Color (RGB)</summary>
      <description>Background Color of Top Bar.</description>
    </key>
    <key type="as" name="dark-bgcolor">
      <default>['0.125', '0.125', '0.125']</default>
      <summary>BG Color (RGB)</summary>
      <description>Background Color of Top Bar.</description>
    </key>
    <key type="as" name="light-bgcolor">
      <default>['0.125', '0.125', '0.125']</default>
      <summary>BG Color (RGB)</summary>
      <description>Background Color of Top Bar.</description>
    </key>
    <key type="d" name="bgalpha">
      <default>0.95</default>
      <summary>Transparency (alpha)</summary>
      <description>Transparency of Top Bar.</description>
    </key>
    <key type="as" name="iscolor">
      <default>['0.125', '0.125', '0.125']</default>
      <summary>Islands BG Color (RGB)</summary>
      <description>Background Color of Islands.</description>
    </key>
    <key type="as" name="dark-iscolor">
      <default>['0.125', '0.125', '0.125']</default>
      <summary>Islands BG Color (RGB)</summary>
      <description>Background Color of Islands.</description>
    </key>
    <key type="as" name="light-iscolor">
      <default>['0.125', '0.125', '0.125']</default>
      <summary>Islands BG Color (RGB)</summary>
      <description>Background Color of Islands.</description>
    </key>
    <key type="d" name="isalpha">
      <default>0.95</default>
      <summary>Transparency (alpha) Islands</summary>
      <description>Transparency of Islands.</description>
    </key>
    <key type="b" name="shadow">
      <default>false</default>
      <summary>Box Shadow</summary>
      <description>Box Shadow of Top Bar.</description>
    </key>
    <key type="as" name="shcolor">
      <default>['0', '0', '0']</default>
      <summary>Panel shadow Color (RGBA)</summary>
      <description>Shadow color of Top Bar.</description>
    </key>
    <key type="as" name="dark-shcolor">
      <default>['0', '0', '0']</default>
      <summary>Panel shadow Color (RGBA)</summary>
      <description>Shadow color of Top Bar.</description>
    </key>
    <key type="as" name="light-shcolor">
      <default>['0', '0', '0']</default>
      <summary>Panel shadow Color (RGBA)</summary>
      <description>Shadow color of Top Bar.</description>
    </key>
    <key type="d" name="shalpha">
      <default>0.2</default>
      <summary>Transparency (alpha) shadow</summary>
      <description>Transparency of panel shadow.</description>
    </key>
    <key type="d" name="bradius">
      <default>30.0</default>
      <summary>Border Radius</summary>
      <description>Convert between rectangle and pill shapes.</description>
    </key>
    <key type="d" name="bwidth">
      <default>2</default>
      <summary>Border Width</summary>
      <description>Border thickness or width.</description>
    </key>
    <key type="as" name="bcolor">
      <default>['1.0', '1.0', '1.0']</default>
      <summary>Border Color (RGBA)</summary>
      <description>Color of Top Bar Border.</description>
    </key>
    <key type="as" name="dark-bcolor">
      <default>['1.0', '1.0', '1.0']</default>
      <summary>Border Color (RGBA)</summary>
      <description>Color of Top Bar Border.</description>
    </key>
    <key type="as" name="light-bcolor">
      <default>['1.0', '1.0', '1.0']</default>
      <summary>Border Color (RGBA)</summary>
      <description>Color of Top Bar Border.</description>
    </key>
    <key type="d" name="balpha">
      <default>0.85</default>
      <summary>Transparency (alpha) border</summary>
      <description>Transparency of border.</description>
    </key>
    <key type="b" name="neon">
      <default>true</default>
      <summary>Neon Effect</summary>
      <description>Neon Effect.</description>
    </key>
    <key type="d" name="height">
      <default>35.0</default>
      <summary>Top Bar height</summary>
      <description>Top Bar height.</description>
    </key>
    <key type="d" name="margin">
      <default>6.5</default>
      <summary>Top Bar margin</summary>
      <description>Top Bar margin.</description>
    </key>
    <key type="as" name="hcolor">
      <default>['0', '0.7', '0.9']</default>
      <summary>Highlight Color (RGBA)</summary>
      <description>Highlight of Top Bar widgets.</description>
    </key>
    <key type="as" name="dark-hcolor">
      <default>['0', '0.7', '0.9']</default>
      <summary>Highlight Color (RGBA)</summary>
      <description>Highlight of Top Bar widgets.</description>
    </key>
    <key type="as" name="light-hcolor">
      <default>['0', '0.7', '0.9']</default>
      <summary>Highlight Color (RGBA)</summary>
      <description>Highlight of Top Bar widgets.</description>
    </key>
    <key type="d" name="halpha">
      <default>0.5</default>
      <summary>Transparency (alpha) Highlight</summary>
      <description>Transparency of highlight.</description>
    </key>
    <key type="b" name="heffect">
      <default>false</default>
      <summary>Highlight effect</summary>
      <description>Highlight effect of Top Bar buttons.</description>
    </key>
    <key type="b" name="reloadstyle">
      <default>false</default>
      <summary>Reload stylesheet</summary>
      <description>Reload stylesheet to apply menu style customizations.</description>
    </key>
    <key type="b" name="wmaxbar">
      <default>false</default>
      <summary>Change bar when window maximized</summary>
      <description>Change bar when window maximized.</description>
    </key>
    <key type="as" name="bgcolor-wmax">
      <default>['0.125', '0.125', '0.125']</default>
      <summary>BG Color (RGB) WMax</summary>
      <description>Background Color of WMax Top Bar.</description>
    </key>
    <key type="as" name="dark-bgcolor-wmax">
      <default>['0.125', '0.125', '0.125']</default>
      <summary>BG Color (RGB) WMax</summary>
      <description>Background Color of WMax Top Bar.</description>
    </key>
    <key type="as" name="light-bgcolor-wmax">
      <default>['0.125', '0.125', '0.125']</default>
      <summary>BG Color (RGB) WMax</summary>
      <description>Background Color of WMax Top Bar.</description>
    </key>
    <key type="d" name="bgalpha-wmax">
      <default>1.0</default>
      <summary>Transparency (alpha) WMax</summary>
      <description>Transparency of WMax Top Bar.</description>
    </key>
    <key type="b" name="neon-wmax">
      <default>false</default>
      <summary>Neon for buttons when window maximized</summary>
      <description>Neon for buttons when window maximized.</description>
    </key>
    <key type="s" name="color-scheme">
      <default>"prefer-dark"</default>
      <summary>Gnome interface-scheme aka Light/Dark mode</summary>
      <description>Gnome interface-scheme aka Light/Dark mode.</description>
    </key>
    <key type="b" name="pause-reload">
      <default>false</default>
      <summary>Indicator to pause style reload</summary>
      <description>Indicator to pause style reload e.g. during auto-theme update.</description>
    </key>
    <key type="b" name="trigger-reload">
      <default>false</default>
      <summary>Trigger to cause style reload</summary>
      <description>Trigger to cause style reload e.g. after auto-theme update.</description>
    </key>
  </schema>
</schemalist>
